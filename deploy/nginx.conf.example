# Reverse-proxy in front of a self-hosted ordo API.
#
# The Node process binds 127.0.0.1 by default. Point this at that port, set
# TRUST_PROXY=1 in apps/server/.env, and do not pass --public.
#
# Put the zone in the http {} block:
#   limit_req_zone $binary_remote_addr zone=ordo:10m rate=30r/s;

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ordo.example.com;

    # ssl_certificate     /etc/letsencrypt/live/ordo.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/ordo.example.com/privkey.pem;

    client_max_body_size 64m;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    location / {
        limit_req zone=ordo burst=60 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
