{
  "name": "@ordo/server",
  "version": "0.1.0",
  "private": true,
  "description": "ordo backend — NestJS + Prisma (SQLite)",
  "license": "AGPL-3.0",
  "scripts": {
    "build": "node ../../node_modules/@nestjs/cli/bin/nest.js build",
    "dev": "node ../../node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config ./test/jest-e2e.js",
    "test:cov": "jest --coverage",
    "db:generate": "DATABASE_URL=\"file:./ordo.db\" prisma generate",
    "db:migrate": "DATABASE_URL=\"file:./ordo.db\" prisma migrate deploy",
    "db:setup": "DATABASE_URL=\"file:./ordo.db\" prisma generate && DATABASE_URL=\"file:./ordo.db\" prisma migrate deploy",
    "db:upgrade": "node dist/prisma/upgrade-cli.js",
    "studio": "prisma studio",
    "clean": "rimraf dist .turbo coverage prisma/*.db src/generated"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "@nestjs/common": "^12.0.2",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.2",
    "@nestjs/platform-express": "^12.0.2",
    "@ordo/shared": "workspace:*",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.6.0",
    "cookie-parser": "^1.4.7",
    "jsdom": "^25.0.1",
    "nodemailer": "^6.9.16",
    "otpauth": "^9.5.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "2.13.1",
    "sharp": "^0.35.4",
    "undici": "^8.10.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.1",
    "@nestjs/schematics": "^12.0.2",
    "@nestjs/testing": "^12.0.2",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^21.1.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/sanitize-html": "^2.13.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^7.10.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
