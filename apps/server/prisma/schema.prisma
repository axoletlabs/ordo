// ordo — SQLite schema
// Run `pnpm --filter @ordo/server db:setup` to generate the client and apply migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String                   @id @default(uuid())
  displayName     String
  email           String                   @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  pendingEmail    String?
  /// JSON-encoded synced reader preferences (see ReaderPreferences in @ordo/shared).
  preferences     String?
  totpSecretEnc   String?
  totpEnabledAt   DateTime?
  avatarMime      String?
  avatarUpdatedAt DateTime?
  /// Used only when AVATAR_STORAGE=database.
  avatarBytes     Bytes?
  /// scrypt salt for the password-wrapped data-encryption key.
  dekKdfSalt      String?
  /// AES-GCM wrap of the library DEK using the account password.
  dekPasswordWrapped String?
  /// AES-GCM wrap of the library DEK using the server library key (email reset).
  dekServerWrapped String?
  /// Unused leftover from recovery-key wraps; kept so existing DBs still load.
  dekRecoveryWrapped String?
  /// 0 = plaintext legacy library; 1 = fields encrypted with the account DEK.
  dataEncryptionVersion Int                @default(0)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  sessions    Session[]
  folders     Folder[]
  bookmarks   Bookmark[]
  tags        Tag[]
  emailTokens EmailVerificationToken[]
  backupCodes MfaBackupCode[]
  mfaChallenges MfaChallenge[]
  importJobs  ImportJob[]
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique
  /// verify | email_change | password_reset
  purpose    String    @default("verify")
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, purpose])
}

model MfaBackupCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MfaChallenge {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  /// login | enroll
  purpose   String
  /// Encrypted pending TOTP secret when purpose = enroll.
  payload   String?
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id                    String   @id @default(cuid())
  userId                String
  accessTokenHash       String   @unique
  accessTokenExpiresAt  DateTime
  refreshTokenHash      String   @unique
  refreshTokenExpiresAt DateTime
  deviceInfo            String?
  deviceName            String?
  deviceType            String?
  ip                    String?
  lastSeenAt            DateTime @default(now())
  /// Library DEK wrapped with HKDF(access token). Null for plaintext users.
  dekWrapped            String?
  /// Library DEK wrapped with HKDF(refresh token).
  dekRefreshWrapped     String?
  /// Previous refresh hash, kept so a reused (stolen) token can kill this session.
  previousRefreshTokenHash String? @unique
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Folder {
  id           String       @id @default(cuid())
  userId       String
  name         String
  icon         String       @default("folder-outline")
  pinned       Boolean      @default(false)
  passwordHash String?
  /// device | pattern | pin | password; null for unlocked folders.
  lockType     String?
  /// 4 or 6 when lockType is pin.
  pinLength    Int?
  position     Int          @default(0)
  // Retained only so legacy default folders can be migrated safely on startup.
  isDefault    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarks  Bookmark[]
  tokens     FolderToken[]

  @@index([userId])
}

model FolderToken {
  id        String   @id @default(cuid())
  folderId  String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId])
}

model Bookmark {
  id              String   @id @default(cuid())
  userId          String
  /** Owning folder; null means the bookmark is unfiled. */
  folderId        String?
  url             String
  title           String
  description     String?
  domain          String
  contentHtml     String?
  fetchStatus     String   @default("ok")
  /** Why extraction ended in `unsupported`/`failed` (ExtractionReason in @ordo/shared). */
  extractionReason String?
  /** Pipeline version that produced the stored content; null = pre-versioning. */
  extractionVersion Int?
  /** User-forced article/website classification (`article` | `web`); null = automatic. */
  contentKindOverride String?
  /** JSON snapshot of the pre-article row, restored when the user unmarks a forced extract. */
  articleUndoSnapshot String?
  author          String?
  publishedAt     DateTime?
  readingTimeMinutes Int?
  readProgress    Float    @default(0)
  completedAt     DateTime?
  isRead          Boolean  @default(false)
  /** Unix seconds. Null means no reminder; a past value stays due until cleared. */
  remindAt        Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder Folder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  tags        BookmarkTag[]
  suggestions BookmarkTagSuggestion[]
  highlights  BookmarkHighlight[]

  @@index([userId])
  @@index([userId, fetchStatus])
  @@index([folderId])
  @@index([createdAt])
  @@index([userId, remindAt])
}

model Tag {
  id             String   @id @default(cuid())
  userId         String
  name           String
  normalizedName String
  color          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarks   BookmarkTag[]
  suggestions BookmarkTagSuggestion[]

  @@unique([userId, normalizedName])
  @@index([userId])
}

model BookmarkTag {
  bookmarkId String
  tagId      String
  createdAt  DateTime @default(now())

  bookmark Bookmark @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([bookmarkId, tagId])
  @@index([tagId])
}

model BookmarkTagSuggestion {
  bookmarkId String
  tagId      String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  bookmark Bookmark @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([bookmarkId, tagId])
  @@index([tagId])
  @@index([bookmarkId, status])
}

/// A reader highlight, anchored by quote rather than HTML offsets.
model BookmarkHighlight {
  id         String   @id @default(cuid())
  bookmarkId String
  exact      String
  prefix     String   @default("")
  suffix     String   @default("")
  href       String?
  createdAt  DateTime @default(now())

  bookmark Bookmark @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)

  @@index([bookmarkId, createdAt])
}

/// Staged import job: uploaded file → parsed preview → confirmed commit.
model ImportJob {
  id           String    @id @default(cuid())
  userId       String
  /// parsing | ready | committing | completed | failed
  status       String    @default("parsing")
  /// ordo-json | netscape-html | csv
  sourceFormat String?
  fileName     String?
  /// JSON-encoded parsed entries (see ParsedEntry in the import-export module).
  entries      String?
  /// JSON-encoded ImportPreviewDto once parsed.
  preview      String?
  /// Human-readable parse or commit failure when status = failed.
  failure      String?
  /// JSON-encoded ImportResultDto once committed.
  result       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  expiresAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Singleton row for this self-hosted instance (display name, etc.).
model InstanceSettings {
  id          String   @id
  name        String
  /// First account (or the oldest remaining one). Null until someone registers.
  ownerUserId String?
  updatedAt   DateTime @updatedAt
}

/// Anonymous app install. No account, email, IP, or server URL.
model AppInstall {
  id          String          @id
  platform    String
  hosting     String
  appVersion  String
  firstSeenAt DateTime
  lastSeenAt  DateTime
  days        AppInstallDay[]

  @@index([firstSeenAt])
  @@index([lastSeenAt])
}

/// Calendar-day presence for an install (UTC `YYYY-MM-DD`).
/// Counters stay on the install id. Sign-in and registration are separate.
/// No account, email, IP, or server URL.
model AppInstallDay {
  installId       String
  day             String
  platform        String
  hosting         String
  appVersion      String
  /// Times the app came to the foreground this day.
  opens           Int     @default(0)
  /// This install completed a sign-in (not a new account) this day.
  loggedIn        Boolean @default(false)
  /// This install created an account this day.
  registered      Boolean @default(false)
  timeouts        Int     @default(0)
  serverErrors    Int     @default(0)
  signInFailures  Int     @default(0)
  startupFast     Int     @default(0)
  startupOk       Int     @default(0)
  startupSlow     Int     @default(0)
  install         AppInstall @relation(fields: [installId], references: [id], onDelete: Cascade)

  @@id([installId, day])
  @@index([day])
}

/// Frozen daily totals so history survives as lastSeenAt moves forward.
model AppInstallSnapshot {
  day      String   @id
  total    Int
  newCount Int
  dau      Int
  wau      Int
  mau      Int
  hosting  String
  platform String
  version  String
  takenAt  DateTime
}
