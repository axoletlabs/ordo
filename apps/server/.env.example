# All optional — the server boots with sensible defaults.
# `./scripts/deploy-server` writes this file on first run. Copy this example
# yourself if you prefer to edit by hand. (.env is gitignored.)

# Server
PORT=3000
# Relative SQLite paths resolve from the prisma/ directory.
DATABASE_URL="file:./ordo.db"
REGISTRATION_ENABLED=true
CORS_ALLOWED_ORIGINS=

# Extra browser origins besides this API itself. Empty = same-origin plus
# localhost (Expo web on another port). Never echoes an unknown Origin.
# ordo Cloud sets this to the public website, e.g. https://ordo.axolet.com
# CORS_ALLOWED_ORIGINS=https://app.example.com

# Security
# JWT_SECRET auto-generates + persists to .ordo-secret if unset
JWT_SECRET=
# LIBRARY_KEK auto-generates + persists to .ordo-library-key if unset
LIBRARY_KEK=

# Email verification (flag-gated). ordo Cloud sets this true.
EMAIL_VERIFICATION_REQUIRED=false

# Require TOTP MFA for every account. Default is off (users can still enroll).
# MFA_REQUIRED=false

# Instance display name. Public GET /api/server/info never includes the OS hostname.
# Self-host: the first account (or INSTANCE_ADMIN_EMAIL) can rename it.
# ordo Cloud sets INSTANCE_RENAME_ENABLED=false so nobody can rename from the app.
# INSTANCE_RENAME_ENABLED=true
# INSTANCE_ADMIN_EMAIL=

# SMTP — used for signup verification, email change, password reset, and notices.
# When unset, one-time codes are printed to the server console (self-host).
# Cloud: set a real SMTP URL and SMTP_REQUIRED=true so codes are never printed.
#
# Resend (https://resend.com/docs/send-with-smtp):
# SMTP_URL=smtp://resend:re_xxxxxxxx@smtp.resend.com:587
# SMTP_FROM=ordo <noreply@your-verified-domain>
# SMTP_REQUIRED=true
# 587 = STARTTLS (works when 465 is blocked). Implicit TLS: 2465.
#
# Optional: point this at Mailpit (or any fake SMTP) in development.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# SMTP_FROM=ordo <noreply@example.com>

# Rate limiting (in-memory; resets on process restart).
# Default is on. Set false to disable login/register/reset/reader limits (local dev).
# RATE_LIMIT_ENABLED=false
# Reverse-proxy hops to trust for X-Forwarded-For. 0 = socket IP only (safe default).
# Set to 1 behind nginx, Caddy, or a Cloudflare tunnel.
# TRUST_PROXY=0
