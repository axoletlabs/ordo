# ordo server configuration — reference
#
# `./scripts/deploy-server` writes apps/server/.env for you, documented and
# complete, secrets included. This file lists every key with its meaning.
# Copy it to apps/server/.env only if you prefer editing by hand (.env is
# gitignored). Every key is optional; the server falls back to the same
# defaults shown here so `pnpm dev` works from a fresh checkout.

# ── HTTP ────────────────────────────────────────────────────────────────

# Port browsers and reverse proxies connect to.
PORT=3000

# Bind address. 127.0.0.1 = this machine only; 0.0.0.0 = this machine and
# the LAN. To face the internet, put nginx or Caddy in front (deploy/ has
# examples) instead of opening the server itself.
LISTEN_HOST=127.0.0.1

# Extra browser origins allowed besides this API itself, comma-separated.
# Empty = same-origin plus localhost (Expo web on another port). An unknown
# Origin is never echoed back.
CORS_ALLOWED_ORIGINS=
# CORS_ALLOWED_ORIGINS=https://app.example.com

# ── Accounts ────────────────────────────────────────────────────────────

# Allow sign-ups after the first account. The first account can always
# register, so a private instance can still be created.
REGISTRATION_ENABLED=false

# Require a one-time email code when signing up or changing email. Without
# mail configured, that code is printed to the server log.
EMAIL_VERIFICATION_REQUIRED=false

# Require TOTP multi-factor auth for every account (users cannot opt out).
MFA_REQUIRED=false

# ── Mail ────────────────────────────────────────────────────────────────

# SMTP URL for signup verification, email change, password reset, notices.
# Empty = one-time codes print to the server log (fine for a private
# instance, wrong for anything public).
SMTP_URL=
# Resend (https://resend.com/docs/send-with-smtp):
# SMTP_URL=smtp://resend:re_xxxxxxxx@smtp.resend.com:587
# 587 = STARTTLS (works when 465 is blocked). Implicit TLS: 2465 or smtps://.
SMTP_FROM=ordo <noreply@ordo.local>

# true = codes are only ever sent by email; mail failures are errors.
# false = fall back to printing codes in the server log. Setup sets this
# true when you give it an SMTP URL.
SMTP_REQUIRED=false

# ── Database ────────────────────────────────────────────────────────────

# SQLite file. Relative paths resolve from apps/server/prisma/.
DATABASE_URL="file:./ordo.db"

# ── Security ────────────────────────────────────────────────────────────

# Session secret. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Everyone is signed out when it changes. Keep a copy with your backups.
# `scripts/deploy-server` generates and writes this on first setup.
JWT_SECRET=

# Wraps the per-library encryption keys (random 64 hex chars). Losing it
# loses access to encrypted libraries. Also generated by setup.
LIBRARY_KEK=

# ── Network & limits ────────────────────────────────────────────────────

# In-memory rate limiting for sign-in, sign-up, and resets. Keep on.
RATE_LIMIT_ENABLED=true

# Reverse-proxy hops to trust for X-Forwarded-For. 0 = socket address only
# (safe default). Set to 1 behind nginx, Caddy, or a Cloudflare tunnel.
TRUST_PROXY=0

# ── Rarely needed ───────────────────────────────────────────────────────

# Where avatar uploads land. Default: next to the database, `<db>-avatars`.
# AVATAR_DIR=/srv/ordo/avatars

# Avatar size cap in bytes (default 2 MB, max 20 MB).
# PROFILE_PICTURE_MAX_BYTES=2097152

# Where avatar bytes are stored: filesystem (default) or database.
# AVATAR_STORAGE=filesystem

# Accept animated (multi-frame) avatars when re-encoding allows it.
# AVATAR_ALLOW_ANIMATED=false

# Instance display name. Public /api/server/info never includes the OS host.
# INSTANCE_RENAME_ENABLED=true
# INSTANCE_ADMIN_EMAIL=owner@example.com
