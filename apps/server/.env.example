# All optional — the server boots with sensible defaults.
# Copy to .env to customize. (.env is gitignored.)

# Server
PORT=3000
# Relative SQLite paths resolve from the prisma/ directory.
DATABASE_URL="file:./ordo.db"
REGISTRATION_ENABLED=true
CORS_ALLOWED_ORIGINS=

# Security
# JWT_SECRET auto-generates + persists to .ordo-secret if unset
JWT_SECRET=

# Email verification (flag-gated)
EMAIL_VERIFICATION_REQUIRED=false

# SMTP — used for signup verification, email change, and password reset.
# When unset, one-time codes are printed to the server console.
# Optional: point this at Mailpit (or any fake SMTP) in development.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# SMTP_FROM=ordo <noreply@example.com>

# Rate limiting (in-memory; resets on process restart).
# Default is on. Set false to disable login/register/reset/reader limits (local dev).
# RATE_LIMIT_ENABLED=false
# Reverse-proxy hops to trust for X-Forwarded-For. 0 = socket IP only (safe default).
# Set to 1 behind nginx, Caddy, or a Cloudflare tunnel.
# TRUST_PROXY=0
