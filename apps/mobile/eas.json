{
  "cli": {
    "version": "24.8.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "environment": "development",
      "env": { "ORDO_APP_VARIANT": "development" }
    },
    "preview": {
      "extends": "stable",
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "env": { "ORDO_APP_VARIANT": "preview", "EXPO_UPDATES_CHANNEL": "preview" }
    },
    "stable": {
      "android": {
        "buildType": "apk"
      },
      "environment": "production",
      "channel": "stable",
      "env": { "ORDO_APP_VARIANT": "stable", "EXPO_UPDATES_CHANNEL": "stable" }
    }
  }
}
