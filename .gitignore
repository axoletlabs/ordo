# dependencies
node_modules/
.pnpm-store/

# builds
dist/
build/
*.tsbuildinfo
out/

# turbo
.turbo/

# env
.env
.env.local
.env.*.local

# prisma / data
*.db
*.db-journal
*.db-shm
*.db-wal
apps/server/prisma/data/
apps/server/src/generated/


# auto-generated secrets and the deploy script's background server
.ordo-secret
# version recorded for the GitHub Release this install is on
apps/server/release.json
.ordo-library-key
.ordo.pid

# Android upload keystore (CI secret; never commit)
*.keystore
*.jks
*.p12

# expo
.expo/
expo-env.d.ts
# Expo OTA signing private key (public cert in apps/mobile/certs/ is committed)
apps/mobile/keys/

# generated native projects (regenerated by `expo prebuild` in CI)
apps/mobile/android/
apps/mobile/ios/

# stray Expo artifacts if it's accidentally run from the repo root instead of
# apps/mobile/ (where the real app lives). Anchored to the repo root only, so
# the legit tracked apps/mobile/app.config.js is NOT ignored.
/android/
/ios/
/app.json

# coverage
coverage/

# os
.DS_Store
Thumbs.db

# editors
.vscode/*
!.vscode/extensions.json
.idea/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# machine-local agent rules (per-VPS setup, not committed; each machine keeps its own)
.cursor/rules/*.local.mdc
