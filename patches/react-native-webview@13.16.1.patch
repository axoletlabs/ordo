+// Apply to this view only. Hold its initial request until compilation finishes;
+// a timeout or compiler error releases the request without blocking anything.
+- (void)setAdBlockingRules:(NSString *)rules
+{
+  if ([_adBlockingRules isEqualToString:rules]) return;
+  _adBlockingRules = [rules copy];
+  NSUInteger generation = ++self.ordoRuleGeneration;
+  self.ordoRulesPending = NO;
+  self.ordoContentRuleList = nil;
+  [_webView.configuration.userContentController removeAllContentRuleLists];
+  if (rules.length == 0) {
+    if (self.ordoSourceWaiting) {
+      self.ordoSourceWaiting = NO;
+      [self visitSource];
+    } else {
+      [_webView reload];
+    }
+    return;
+  }
+  NSDictionary *config = [NSJSONSerialization JSONObjectWithData:[rules dataUsingEncoding:NSUTF8StringEncoding] options:0 error:nil];
+  NSString *encoded = [config isKindOfClass:NSDictionary.class] ? config[@"webKitRules"] : nil;
+  if (![encoded isKindOfClass:NSString.class]) {
+    if (self.ordoSourceWaiting) {
+      self.ordoSourceWaiting = NO;
+      [self visitSource];
+    } else {
+      [_webView reload];
+    }
+    return;
+  }
+  self.ordoRulesPending = YES;
+  __weak RNCWebViewImpl *weakSelf = self;
+  void (^finish)(WKContentRuleList *) = ^(WKContentRuleList *list) {
+    RNCWebViewImpl *strongSelf = weakSelf;
+    if (!strongSelf || strongSelf.ordoRuleGeneration != generation || !strongSelf.ordoRulesPending) return;
+    strongSelf.ordoRulesPending = NO;
+    strongSelf.ordoContentRuleList = list;
+    if (list) [strongSelf.webView.configuration.userContentController addContentRuleList:list];
+    if (strongSelf.ordoSourceWaiting) {
+      strongSelf.ordoSourceWaiting = NO;
+      [strongSelf visitSource];
+    } else {
+      [strongSelf.webView reload];
+    }
+  };
+  // A fixed identifier replaces this app-owned entry instead of accumulating
+  // compiled lists every time a user changes a site exception.
+  [[WKContentRuleListStore defaultStore] compileContentRuleListForIdentifier:@"ordo-ads-v1"
+    encodedContentRuleList:encoded completionHandler:^(WKContentRuleList *list, NSError *error) {
+      dispatch_async(dispatch_get_main_queue(), ^{ finish(list); });
+    }];
+  dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 3 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{ finish(nil); });
+}
