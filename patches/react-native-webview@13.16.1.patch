index 0000000000000000000000000000000000000000..532d1ff11d66e063d2f5a958b6feaff006d86724
--- /dev/null
+++ b/android/src/main/java/com/reactnativecommunity/webview/OrdoAdBlocker.java
@@ -0,0 +1,107 @@
+package com.reactnativecommunity.webview;
+
+import java.net.URI;
+import java.util.Collection;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.Locale;
+import java.util.Set;
+
+/** Per-WebView immutable host rules. No network, disk access or JS bridge on the request thread. */
+public final class OrdoAdBlocker {
+    public static final OrdoAdBlocker DISABLED = new OrdoAdBlocker(Collections.emptySet(), Collections.emptySet());
+    private final Set<String> blockedHosts;
+    private final Set<String> allowedHosts;
+
+    public OrdoAdBlocker(Collection<String> blockedHosts, Collection<String> allowedHosts) {
+        this.blockedHosts = normalized(blockedHosts);
+        this.allowedHosts = normalized(allowedHosts);
+    }
+
+    private static Set<String> normalized(Collection<String> hosts) {
+        Set<String> result = new HashSet<>();
+        for (String host : hosts) {
+            if (host == null) continue;
+            String canonical = webHost("https://" + host + "/");
+            if (canonical != null && canonical.equals(normalizeHost(host))) result.add(canonical);
+        }
+        return Collections.unmodifiableSet(result);
+    }
+
+    private static String normalizeHost(String host) {
+        String result = host.toLowerCase(Locale.ROOT);
+        while (result.endsWith(".")) result = result.substring(0, result.length() - 1);
+        return result;
+    }
+
+    private static String webHost(String url) {
+        try {
+            URI uri = new URI(url);
+            if (!"https".equalsIgnoreCase(uri.getScheme()) && !"http".equalsIgnoreCase(uri.getScheme())) return null;
+            String host = uri.getHost();
+            return host == null ? null : normalizeHost(host);
+        } catch (Exception ignored) {
+            return null;
+        }
+    }
+
+    /** Immutable request observation shared by the request and UI threads. */
+    public static final class PageRequest {
+        public static final PageRequest UNKNOWN = new PageRequest("", "");
+        private final String url;
+        private final String method;
+
+        public PageRequest(String url, String method) {
+            this.url = url;
+            this.method = method;
+        }
+
+        public boolean canReload(String currentUrl) {
+            return currentUrl != null && !currentUrl.isEmpty() && currentUrl.equals(url)
+                && "GET".equalsIgnoreCase(method) && webHost(currentUrl) != null;
+        }
+    }
+
+    public boolean shouldBlock(String requestUrl, String topUrl, boolean mainFrame) {
+        if (mainFrame || blockedHosts.isEmpty()) return false;
+        String top = webHost(topUrl);
+        String host = webHost(requestUrl);
+        if (top == null || host == null || top.isEmpty() || host.isEmpty() || allowedHosts.contains(top)) return false;
+        // Walk DNS labels, never substrings: doubleclick.net.example.org is not an ad host.
+        String candidate = host;
+        while (true) {
+            if (blockedHosts.contains(candidate)) {
+                // A direct visit to an ad provider still works, including its own subdomains.
+                return !top.equals(candidate) && !top.endsWith("." + candidate);
+            }
+            int dot = candidate.indexOf('.');
+            if (dot < 0) return false;
+            candidate = candidate.substring(dot + 1);
+        }
+    }
+
+    public boolean shouldBlockResource(String requestUrl, String topUrl, boolean mainFrame, String method, String accept) {
+        // Never synthesize responses for submissions, CORS preflights or frame
+        // documents. Android does not expose WebKit's resource-type classifier.
+        if (!"GET".equalsIgnoreCase(method)) return false;
+        if (accept != null) {
+            String types = accept.toLowerCase(Locale.ROOT);
+            if (types.contains("text/html") || types.contains("application/xhtml+xml")) return false;
+        }
+        return shouldBlock(requestUrl, topUrl, mainFrame);
+    }
+
+    private Set<String> pageRules(String topUrl) {
+        String top = webHost(topUrl);
+        if (top == null || allowedHosts.contains(top)) return Collections.emptySet();
+        Set<String> result = new HashSet<>();
+        for (String host : blockedHosts) {
+            if (!top.equals(host) && !top.endsWith("." + host)) result.add(host);
+        }
+        return result;
+    }
+
+    public boolean changesPageRules(OrdoAdBlocker previous, String topUrl) {
+        return !pageRules(topUrl).equals(previous.pageRules(topUrl));
+    }
+}
