@@ -66,6 +66,60 @@ public class RNCWebView extends WebView implements LifecycleEventListener {
     protected boolean injectedJavaScriptForMainFrameOnly = true;
     protected boolean injectedJavaScriptBeforeContentLoadedForMainFrameOnly = true;
 
+    // Immutable configuration published to WebView's request thread.
+    protected volatile OrdoAdBlocker adBlocker = OrdoAdBlocker.DISABLED;
+    protected volatile String adBlockTopUrl = "";
+    protected volatile OrdoAdBlocker.PageRequest adBlockPageRequest = OrdoAdBlocker.PageRequest.UNKNOWN;
+    private String adBlockingRules = "";
+
+    public void setAdBlockingRules(@Nullable String value) {
+        String next = value == null ? "" : value;
+        if (next.equals(adBlockingRules)) return;
+        adBlockingRules = next;
+        OrdoAdBlocker config = OrdoAdBlocker.DISABLED;
+        try {
+            if (!next.isEmpty()) {
+                JSONObject json = new JSONObject(next);
+                org.json.JSONArray hosts = json.getJSONArray("blockedHosts");
+                org.json.JSONArray allowed = json.getJSONArray("allowedHosts");
+                java.util.List<String> blockedHosts = new java.util.ArrayList<>();
+                java.util.List<String> allowedHosts = new java.util.ArrayList<>();
+                for (int i = 0; i < hosts.length(); i++) blockedHosts.add(hosts.getString(i));
+                for (int i = 0; i < allowed.length(); i++) allowedHosts.add(allowed.getString(i));
+                config = new OrdoAdBlocker(blockedHosts, allowedHosts);
+            }
+        } catch (JSONException ignored) {
+            // Invalid configuration must never prevent a page loading.
+        }
+        OrdoAdBlocker previous = adBlocker;
+        adBlocker = config;
+        String current = getUrl();
+        // Updating another site's preference must not interrupt this page.
+        // Let in-flight navigations finish; new requests already see the rules.
+        if (getProgress() == 100 && adBlockPageRequest.canReload(current)
+                && config.changesPageRules(previous, current)) reload();
+    }
+
+    // Cached history entries may not issue a new request. Do not assume that
+    // the previous page's method describes a restored form response.
+    @Override
+    public void goBack() {
+        adBlockPageRequest = OrdoAdBlocker.PageRequest.UNKNOWN;
+        super.goBack();
+    }
+
+    @Override
+    public void goForward() {
+        adBlockPageRequest = OrdoAdBlocker.PageRequest.UNKNOWN;
+        super.goForward();
+    }
+
+    @Override
+    public void goBackOrForward(int steps) {
+        adBlockPageRequest = OrdoAdBlocker.PageRequest.UNKNOWN;
+        super.goBackOrForward(steps);
+    }
+
     protected boolean messagingEnabled = false;
     protected @Nullable
     String messagingModuleName;
