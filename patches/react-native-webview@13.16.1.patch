diff --git a/apple/OrdoAdBlocking.h b/apple/OrdoAdBlocking.h
new file mode 100644
index 0000000000000000000000000000000000000000..5b54e01d31b32e7c53fbd83575bbdf184b762780
--- /dev/null
+++ b/apple/OrdoAdBlocking.h
@@ -0,0 +1,16 @@
+#import <Foundation/Foundation.h>
+
+// Compare the effective policy for this page, independently of other sites'
+// exceptions or JSON ordering. Used only on the main thread during updates.
+static inline NSSet<NSString *> *OrdoPageAdRules(NSDictionary *config, NSURL *url)
+{
+  NSString *scheme = url.scheme.lowercaseString;
+  if (!([scheme isEqualToString:@"https"] || [scheme isEqualToString:@"http"])) return [NSSet set];
+  NSString *top = [url.host.lowercaseString stringByTrimmingCharactersInSet:[NSCharacterSet characterSetWithCharactersInString:@"."]];
+  if (!top.length || [config[@"allowedHosts"] containsObject:top]) return [NSSet set];
+  NSMutableSet *hosts = [NSMutableSet set];
+  for (NSString *host in config[@"blockedHosts"]) {
+    if (![top isEqualToString:host] && ![top hasSuffix:[@"." stringByAppendingString:host]]) [hosts addObject:host];
+  }
+  return hosts;
+}
