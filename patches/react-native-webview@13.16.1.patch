+    // Immutable configuration published to WebView's request thread.
+    protected volatile OrdoAdBlocker adBlocker = OrdoAdBlocker.DISABLED;
+    protected volatile String adBlockTopUrl = "";
+    private String adBlockingRules = "";
+
+    public void setAdBlockingRules(@Nullable String value) {
+        String next = value == null ? "" : value;
+        if (next.equals(adBlockingRules)) return;
+        adBlockingRules = next;
+        OrdoAdBlocker config = OrdoAdBlocker.DISABLED;
+        try {
+            if (!next.isEmpty()) {
+                JSONObject json = new JSONObject(next);
+                org.json.JSONArray hosts = json.getJSONArray("blockedHosts");
+                org.json.JSONArray allowed = json.getJSONArray("allowedHosts");
+                java.util.List<String> blockedHosts = new java.util.ArrayList<>();
+                java.util.List<String> allowedHosts = new java.util.ArrayList<>();
+                for (int i = 0; i < hosts.length(); i++) blockedHosts.add(hosts.getString(i));
+                for (int i = 0; i < allowed.length(); i++) allowedHosts.add(allowed.getString(i));
+                config = new OrdoAdBlocker(blockedHosts, allowedHosts);
+            }
+        } catch (JSONException ignored) {
+            // Invalid configuration must never prevent a page loading.
+        }
+        adBlocker = config;
+        String current = getUrl();
+        if (current != null && (current.startsWith("https://") || current.startsWith("http://"))) reload();
+    }
+
