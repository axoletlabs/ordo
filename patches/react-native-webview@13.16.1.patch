+    if (strongSelf.ordoContentRuleList) [strongSelf.webView.configuration.userContentController removeContentRuleList:strongSelf.ordoContentRuleList];
+    strongSelf.ordoContentRuleList = list;
+    strongSelf.ordoActiveRuleConfig = next;
+    if (list) [strongSelf.webView.configuration.userContentController addContentRuleList:list];
+    BOOL refreshRequested = strongSelf.ordoReloadWaiting;
+    strongSelf.ordoReloadWaiting = NO;
+    if (strongSelf.ordoSourceWaiting) {
+      strongSelf.ordoSourceWaiting = NO;
+      [strongSelf visitSource];
+    } else if (refreshRequested || (changed && !strongSelf.webView.loading && strongSelf.ordoTopNavigationCanReload)) {
+      // Never interrupt a navigation or replay a submitted form automatically.
+      [strongSelf reload];
+    }
