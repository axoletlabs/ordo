+  if (![config isKindOfClass:NSDictionary.class] || ![config[@"blockedHosts"] isKindOfClass:NSArray.class] || ![config[@"allowedHosts"] isKindOfClass:NSArray.class]) config = nil;
+  for (id host in [config[@"blockedHosts"] arrayByAddingObjectsFromArray:config[@"allowedHosts"]]) {
